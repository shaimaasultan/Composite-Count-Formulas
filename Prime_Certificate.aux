\@writefile{toc}{\contentsline {subsection}{\numberline {42.1}Spokes are points; the two knobs are two points}{43}{subsection.42.1}\protected@file@percent }
\newlabel{def:sqpt}{{11}{43}{Square-point}{definition.11}{}}
\newlabel{prop:grouplaw}{{50}{43}{The additive closure is the group law}{proposition.50}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {42.2}The forced cells are chord-and-reflect images}{43}{subsection.42.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Both forced cells as group-law images on the associated elliptic curve (illustrative model $y^{2}=x^{3}+17$). The two green points $P,Q$ are the free spokes --- the knobs $\gamma _1,\gamma _2$. The orange line through $P$ and $Q$ meets the cubic at a third point; reflecting it gives $P\oplus Q$, the forced spoke $\gamma _3=\gamma _1+\gamma _2$ (cells $B,H$). The violet line through $P$ and $-Q$ (the reflection of $Q$) gives $P\ominus Q$, the forced spoke $\gamma _4=\gamma _1-\gamma _2$ (cells $C,G$). Both forced spokes are manufactured by the group law from the two knobs; neither carries any freedom. A nine-square magic square needs both $P\oplus Q$ and $P\ominus Q$ to be square-points at once.}}{43}{figure.3}\protected@file@percent }
\newlabel{fig:ecgrouplaw}{{3}{43}{Both forced cells as group-law images on the associated elliptic curve (illustrative model $y^{2}=x^{3}+17$). The two green points $P,Q$ are the free spokes --- the knobs $\gamma _1,\gamma _2$. The orange line through $P$ and $Q$ meets the cubic at a third point; reflecting it gives $P\oplus Q$, the forced spoke $\gamma _3=\gamma _1+\gamma _2$ (cells $B,H$). The violet line through $P$ and $-Q$ (the reflection of $Q$) gives $P\ominus Q$, the forced spoke $\gamma _4=\gamma _1-\gamma _2$ (cells $C,G$). Both forced spokes are manufactured by the group law from the two knobs; neither carries any freedom. A nine-square magic square needs both $P\oplus Q$ and $P\ominus Q$ to be square-points at once}{figure.3}{}}
\newlabel{rem:paralaw}{{34}{44}{Sum and difference are a matched pair}{remark.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The subtraction view, $P\ominus Q=P\oplus (-Q)$. The second square-point $Q$ is taken on the lower branch, so its reflection $-Q$ is nearly level with $P$ and the chord $P\,\text  {--}\,(-Q)$ is almost flat; its third intersection sits near the axis and reflecting gives $P\ominus Q=(-\genfrac  {}{}{}189,-\genfrac  {}{}{}1{109}{27})$, lying \emph  {between} the two square-points $P$ and $Q$. The operation is the same group law as in Figure\nobreakspace  {}\ref  {fig:ecgrouplaw}; only the height budget of Remark\nobreakspace  {}\ref  {rem:paralaw} decides whether the difference lands near the knobs or far beyond them.}}{44}{figure.4}\protected@file@percent }
\newlabel{fig:ecminus}{{4}{44}{The subtraction view, $P\ominus Q=P\oplus (-Q)$. The second square-point $Q$ is taken on the lower branch, so its reflection $-Q$ is nearly level with $P$ and the chord $P\,\text {--}\,(-Q)$ is almost flat; its third intersection sits near the axis and reflecting gives $P\ominus Q=(-\tfrac 89,-\tfrac {109}{27})$, lying \emph {between} the two square-points $P$ and $Q$. The operation is the same group law as in Figure~\ref {fig:ecgrouplaw}; only the height budget of Remark~\ref {rem:paralaw} decides whether the difference lands near the knobs or far beyond them}{figure.4}{}}
\newlabel{rem:negate}{{35}{44}{Negating a knob reflects the outputs}{remark.35}{}}
\newlabel{rem:signbranch}{{36}{44}{Sign $=$ branch $=$ below/above}{remark.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The reflected-knob view. Using $-P$ (the reflection of $P$) with the same $Q$, the orange chord $(-P)\,\text  {--}\,Q$ gives $(-P)\oplus Q=(4,9)$ and the violet chord $(-P)\,\text  {--}\,(-Q)$ gives $(-P)\ominus Q=(\genfrac  {}{}{}114,\genfrac  {}{}{}1{33}{8})$. By Remark\nobreakspace  {}\ref  {rem:negate} these are $-(P\ominus Q)$ and $-(P\oplus Q)$: exactly the sum and difference of Figure\nobreakspace  {}\ref  {fig:ecgrouplaw} reflected across the axis, with their roles swapped. The same magic square, read from the mirrored ends of its spokes.}}{45}{figure.5}\protected@file@percent }
\newlabel{fig:ecnegP}{{5}{45}{The reflected-knob view. Using $-P$ (the reflection of $P$) with the same $Q$, the orange chord $(-P)\,\text {--}\,Q$ gives $(-P)\oplus Q=(4,9)$ and the violet chord $(-P)\,\text {--}\,(-Q)$ gives $(-P)\ominus Q=(\tfrac 14,\tfrac {33}{8})$. By Remark~\ref {rem:negate} these are $-(P\ominus Q)$ and $-(P\oplus Q)$: exactly the sum and difference of Figure~\ref {fig:ecgrouplaw} reflected across the axis, with their roles swapped. The same magic square, read from the mirrored ends of its spokes}{figure.5}{}}
\newlabel{rem:centrefixed}{{37}{45}{The centre is the fixed point of the reflection}{remark.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Why $k$ is fixed, not chosen. The curve is symmetric across the $x$-axis, $(x,y)\DOTSB \mapstochar \rightarrow (x,-y)$ (negation $P\DOTSB \mapstochar \rightarrow -P$): every point pairs with its mirror on the other leg (green pairs, dashed connectors), so the two legs carry the $\pm $ spokes $k^{2}\mp \gamma $. The single point fixed by the reflection is where the curve meets the axis, $y=0$ --- offset $\delta =0$, the degenerate spoke $\gamma =0$, i.e.\ the centre $k^{2}$. It lies on the axis of symmetry, pinned rather than chosen; in the normalised value view it is the fixed point $1$ of $x\DOTSB \mapstochar \rightarrow 2-x$ (Remark\nobreakspace  {}\ref  {rem:centrefixed}). So $k$ is the reflection's fixed point, not a free parameter.}}{46}{figure.6}\protected@file@percent }
\newlabel{fig:centrefixed}{{6}{46}{Why $k$ is fixed, not chosen. The curve is symmetric across the $x$-axis, $(x,y)\mapsto (x,-y)$ (negation $P\mapsto -P$): every point pairs with its mirror on the other leg (green pairs, dashed connectors), so the two legs carry the $\pm $ spokes $k^{2}\mp \gamma $. The single point fixed by the reflection is where the curve meets the axis, $y=0$ --- offset $\delta =0$, the degenerate spoke $\gamma =0$, i.e.\ the centre $k^{2}$. It lies on the axis of symmetry, pinned rather than chosen; in the normalised value view it is the fixed point $1$ of $x\mapsto 2-x$ (Remark~\ref {rem:centrefixed}). So $k$ is the reflection's fixed point, not a free parameter}{figure.6}{}}
\newlabel{rem:trig}{{38}{46}{Locating a chord's crossing by symmetry}{remark.38}{}}
\newlabel{rem:crosslever}{{39}{46}{Crossing versus shift: a lever law}{remark.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Locating the crossing by symmetry. The mirror axis is $y=0$; the heights of the two endpoints, $|y_Q|=3$ and $|y_{-P}|=5$ (perpendiculars, right angles at their feet), form two similar right triangles sharing the crossing $x_0$ (equal vertical angles, marked). The run therefore splits in the ratio of the heights, $1.5:2.5=3:5$, giving $x_0=(x_A y_B-x_B y_A)/(y_B-y_A)=-\genfrac  {}{}{}112$ (Remark\nobreakspace  {}\ref  {rem:trig}). The symmetry alone --- the two amplitudes measured from the axis --- fixes the crossing by trigonometry.}}{47}{figure.7}\protected@file@percent }
\newlabel{fig:trigcross}{{7}{47}{Locating the crossing by symmetry. The mirror axis is $y=0$; the heights of the two endpoints, $|y_Q|=3$ and $|y_{-P}|=5$ (perpendiculars, right angles at their feet), form two similar right triangles sharing the crossing $x_0$ (equal vertical angles, marked). The run therefore splits in the ratio of the heights, $1.5:2.5=3:5$, giving $x_0=(x_A y_B-x_B y_A)/(y_B-y_A)=-\tfrac 12$ (Remark~\ref {rem:trig}). The symmetry alone --- the two amplitudes measured from the axis --- fixes the crossing by trigonometry}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces The lever law of Remark\nobreakspace  {}\ref  {rem:crosslever}. The centre axis is the beam; the signed shifts $\sigma _2=+3$ (above, at foot $u_2=-2$) and $\sigma _1=-5$ (below, at $u_1=2$) act as opposing moments, and the chord through the two tips crosses the axis at the balance point $x_0=-\genfrac  {}{}{}112$. There $\sigma _2(x_0-u_1)=\sigma _1(x_0-u_2)$, i.e.\ $3(-2.5)=(-5)(1.5)=-7.5$. Opposite signs put the fulcrum \emph  {between} the feet; the centre $k^{2}$ is the zero-moment point $\sigma =0$.}}{47}{figure.8}\protected@file@percent }
\newlabel{fig:lever}{{8}{47}{The lever law of Remark~\ref {rem:crosslever}. The centre axis is the beam; the signed shifts $\sigma _2=+3$ (above, at foot $u_2=-2$) and $\sigma _1=-5$ (below, at $u_1=2$) act as opposing moments, and the chord through the two tips crosses the axis at the balance point $x_0=-\tfrac 12$. There $\sigma _2(x_0-u_1)=\sigma _1(x_0-u_2)$, i.e.\^^M$3(-2.5)=(-5)(1.5)=-7.5$. Opposite signs put the fulcrum \emph {between} the feet; the centre $k^{2}$ is the zero-moment point $\sigma =0$}{figure.8}{}}
\newlabel{rem:axisanchors}{{40}{48}{Two axis-anchors replace the second knob}{remark.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Two axis-anchors replace the second knob (Remark\nobreakspace  {}\ref  {rem:axisanchors}). From the one knob $Q=(-2,3)$ and the root $x_1=-\sqrt  [3]{17}$ (the curve's axis-crossing, the centre), two linear equations return the curve $a=0,\ b=17$. The crossing $x_0=-\genfrac  {}{}{}112$ then fixes the chord through $Q$ (slope $y_Q/(x_Q-x_0)=-2$), which re-meets the curve at the recovered point $P=(2,-5)$ (and a third point $(4,-9)$). So $\{Q;x_0,x_1\}$ carries the same information as $\{P,Q\}$: $x_1$ the curve, $x_0$ the chord.}}{48}{figure.9}\protected@file@percent }
\newlabel{fig:axisanchors}{{9}{48}{Two axis-anchors replace the second knob (Remark~\ref {rem:axisanchors}). From the one knob $Q=(-2,3)$ and the root $x_1=-\sqrt [3]{17}$ (the curve's axis-crossing, the centre), two linear equations return the curve $a=0,\ b=17$. The crossing $x_0=-\tfrac 12$ then fixes the chord through $Q$ (slope $y_Q/(x_Q-x_0)=-2$), which re-meets the curve at the recovered point $P=(2,-5)$ (and a third point $(4,-9)$). So $\{Q;x_0,x_1\}$ carries the same information as $\{P,Q\}$: $x_1$ the curve, $x_0$ the chord}{figure.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {42.3}A circular relation: the curve buys no freedom}{48}{subsection.42.3}\protected@file@percent }
\newlabel{sec:circular}{{42.3}{48}{A circular relation: the curve buys no freedom}{subsection.42.3}{}}
\newlabel{prop:circular}{{51}{49}{The spoke quantities satisfy one incidence relation}{proposition.51}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces The circular relation (Proposition\nobreakspace  {}\ref  {prop:circular}). The three axis quantities $x_1$ (centre), $x_0$ (crossing), $x_2$ (recovered abscissa), together with the knob $Q$ and the reflected ``square'' point $+P$, close into one loop (blue): fixing the curve $x_1$ and any two of $\{Q,x_0,x_2\}$ forces the rest. The yellow triangle $x_1x_0Q$ is one face of it. The degree-three curve provides the incidence but no extra freedom: the square stays two degrees of freedom (the two spokes), the curve buying nothing.}}{49}{figure.10}\protected@file@percent }
\newlabel{fig:circular}{{10}{49}{The circular relation (Proposition~\ref {prop:circular}). The three axis quantities $x_1$ (centre), $x_0$ (crossing), $x_2$ (recovered abscissa), together with the knob $Q$ and the reflected ``square'' point $+P$, close into one loop (blue): fixing the curve $x_1$ and any two of $\{Q,x_0,x_2\}$ forces the rest. The yellow triangle $x_1x_0Q$ is one face of it. The degree-three curve provides the incidence but no extra freedom: the square stays two degrees of freedom (the two spokes), the curve buying nothing}{figure.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {42.4}Why seven and not nine}{49}{subsection.42.4}\protected@file@percent }
\newlabel{thm:rankopen}{{23}{49}{Existence is a rank question, not a freedom count}{theorem.23}{}}
\newlabel{rem:rankdof}{{41}{50}{Rank enlarges the supply, not the freedom}{remark.41}{}}
\newlabel{rem:coupled}{{42}{50}{The six conditions are coupled, not independent}{remark.42}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces All six lie inside \emph  {one} closed convex. The six conditions are the vertices of a single hexagon; the two inscribed triples $\{S_1,S_3,S_5\}$ (blue) and $\{S_2,S_4,S_6\}$ (orange) \emph  {interlock} and cannot be pulled apart into two independent convex pieces. This is the coupling made visible: rank two in $(A,D)$ (Remark\nobreakspace  {}\ref  {rem:coupled}) means $(S_1,S_2,S_3)$ always depends on $(S_4,S_5,S_6)$, so the six squareness demands live in a single closure, never split three-and-three into separate ones. The algebraic form of the same fact --- all six functions of the two knobs $A,D$ --- is Figure\nobreakspace  {}\ref  {fig:coupling}.}}{51}{figure.11}\protected@file@percent }
\newlabel{fig:nohexagon}{{11}{51}{All six lie inside \emph {one} closed convex. The six conditions are the vertices of a single hexagon; the two inscribed triples $\{S_1,S_3,S_5\}$ (blue) and $\{S_2,S_4,S_6\}$ (orange) \emph {interlock} and cannot be pulled apart into two independent convex pieces. This is the coupling made visible: rank two in $(A,D)$ (Remark~\ref {rem:coupled}) means $(S_1,S_2,S_3)$ always depends on $(S_4,S_5,S_6)$, so the six squareness demands live in a single closure, never split three-and-three into separate ones. The algebraic form of the same fact --- all six functions of the two knobs $A,D$ --- is Figure~\ref {fig:coupling}}{figure.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {42.5}A network formulation and a bounded search}{51}{subsection.42.5}\protected@file@percent }
\newlabel{sec:network}{{42.5}{51}{A network formulation and a bounded search}{subsection.42.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces The six on one closed hexagon, and the full dependency web. \emph  {Left:} were the six conditions free they would be independent vertices with no shared handle. \emph  {Right:} as a coupled system the eight border cells form the \emph  {complete} graph $K_8$: a generic change of the two knobs $(A,D)$ moves \emph  {all eight} cells at once, so every pair co-varies and every node has degree seven. (Writing $F=2k^2-D$, $I=2k^2-A$ in the $(A,D)$ basis makes $F,I$ look tied to a single knob, but the row and column sums re-adjust every cell, so $F$ and $I$ move with the rest --- the graph is fully connected, not near-connected.) One fixes $(A,D)$ and the octagon settles the other cells through its relations; normalised by $k^2$ the eight vertex-weights sum to $8$ (Proposition\nobreakspace  {}\ref  {prop:sumfree}). This is why no three cells can be freed from the other three (Remark\nobreakspace  {}\ref  {rem:coupled}), and the record settles at four (Theorem\nobreakspace  {}\ref  {thm:target}) rather than climbing cell by cell.}}{52}{figure.12}\protected@file@percent }
\newlabel{fig:coupling}{{12}{52}{The six on one closed hexagon, and the full dependency web. \emph {Left:} were the six conditions free they would be independent vertices with no shared handle. \emph {Right:} as a coupled system the eight border cells form the \emph {complete} graph $K_8$: a generic change of the two knobs $(A,D)$ moves \emph {all eight} cells at once, so every pair co-varies and every node has degree seven. (Writing $F=2k^2-D$, $I=2k^2-A$ in the $(A,D)$ basis makes $F,I$ look tied to a single knob, but the row and column sums re-adjust every cell, so $F$ and $I$ move with the rest --- the graph is fully connected, not near-connected.) One fixes $(A,D)$ and the octagon settles the other cells through its relations; normalised by $k^2$ the eight vertex-weights sum to $8$ (Proposition~\ref {prop:sumfree}). This is why no three cells can be freed from the other three (Remark~\ref {rem:coupled}), and the record settles at four (Theorem~\ref {thm:target}) rather than climbing cell by cell}{figure.12}{}}
\newlabel{rem:corneredge}{{43}{52}{The two knobs are a corner and an edge}{remark.43}{}}
\newlabel{rem:symmarith}{{44}{53}{The network closes the symmetry; squareness rides on top}{remark.44}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {42.6}What selects a centre: mod 8, closure, and the hypotenuse}{53}{subsection.42.6}\protected@file@percent }
\newlabel{sec:selectk}{{42.6}{53}{What selects a centre: mod 8, closure, and the hypotenuse}{subsection.42.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Two layers. \emph  {Left (on the curve):} the elliptic curve's reflection across the $x$-axis, $P\leftrightarrow -P$, closes every antipodal pair (cell $+$ companion $=2k^2$) --- a genuine symmetry that always holds, treating the diagonal pair and the middle-row pair identically. \emph  {Right (in the grid):} the two free cells sit at a corner ($A$, coefficient $2$) and an edge ($D$, coefficient $1$); swapping them is \emph  {not} a symmetry, so an edge value forced to the corner breaks the score. The closing symmetry lives on the curve; the breaking asymmetry lives on the grid --- different layers, which is why the swap cannot be shown ``breaking'' on the curve itself.}}{54}{figure.13}\protected@file@percent }
\newlabel{fig:twolayers}{{13}{54}{Two layers. \emph {Left (on the curve):} the elliptic curve's reflection across the $x$-axis, $P\leftrightarrow -P$, closes every antipodal pair (cell $+$ companion $=2k^2$) --- a genuine symmetry that always holds, treating the diagonal pair and the middle-row pair identically. \emph {Right (in the grid):} the two free cells sit at a corner ($A$, coefficient $2$) and an edge ($D$, coefficient $1$); swapping them is \emph {not} a symmetry, so an edge value forced to the corner breaks the score. The closing symmetry lives on the curve; the breaking asymmetry lives on the grid --- different layers, which is why the swap cannot be shown ``breaking'' on the curve itself}{figure.13}{}}
